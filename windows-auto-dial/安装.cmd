@echo off
setlocal
cd /d "%~dp0"
echo ===== kdlink 开机自动拨号 - 安装 =====
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $q=[char]34; $v='%~dp0AutoDial.vbs'; if(-not (Test-Path $v)){ Write-Host '[错误] 找不到 AutoDial.vbs，请把它和本文件放在同一文件夹。' -ForegroundColor Red; exit 1 }; $dir=Join-Path $env:LOCALAPPDATA 'AutoDial'; [void](New-Item -ItemType Directory -Path $dir -Force); $dst=Join-Path $dir 'AutoDial.vbs'; $u=''; $p=''; if(Test-Path $dst){ $o=Get-Content -LiteralPath $dst -Raw; $reU='(?m)^Const\s+USERNAME\s*=\s*'+$q+'([^'+$q+']*)'+$q; $reP='(?m)^Const\s+PASSWORD\s*=\s*'+$q+'([^'+$q+']*)'+$q; if($o -match $reU){ $u=$Matches[1] }; if($o -match $reP){ $p=$Matches[1] } }; Copy-Item -LiteralPath $v -Destination $dst -Force; if($u -or $p){ $lines=@(Get-Content -LiteralPath $dst); for($i=0;$i -lt $lines.Count;$i++){ if($lines[$i] -match '^Const\s+USERNAME'){ $lines[$i]='Const USERNAME   = '+$q+$u+$q } elseif($lines[$i] -match '^Const\s+PASSWORD'){ $lines[$i]='Const PASSWORD   = '+$q+$p+$q } }; Set-Content -LiteralPath $dst -Value $lines -Encoding Default }; $lnk=Join-Path ([Environment]::GetFolderPath('Startup')) 'AutoDial.lnk'; $w=New-Object -ComObject WScript.Shell; $k=$w.CreateShortcut($lnk); $k.TargetPath=Join-Path $env:WINDIR 'System32\wscript.exe'; $k.Arguments=$q+$dst+$q; $k.WorkingDirectory=$dir; $k.Description='kdlink autodial'; $k.WindowStyle=7; $k.Save(); Write-Host ('[1/2] 脚本   : '+$dst) -ForegroundColor Green; Write-Host ('[2/2] 启动项 : '+$lnk) -ForegroundColor Green; $t=Get-Content -LiteralPath $dst -Raw; if($t -match ('(?m)^Const\s+USERNAME\s*=\s*'+$q+$q)){ Write-Host ''; Write-Host '注意：账号密码还没填，会一直报 628。' -ForegroundColor Yellow; Write-Host '现在打开记事本，请填好开头的 USERNAME / PASSWORD 两行。' -ForegroundColor Yellow; Start-Process notepad $dst } else { Write-Host ''; Write-Host '账号密码已存在或已保留，安装完成。' -ForegroundColor Green }"
echo.
pause